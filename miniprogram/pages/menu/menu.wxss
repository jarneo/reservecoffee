/* 顾客端店铺菜单 —— 对齐 design/menu-design.html 原型 */
.hero { padding: 28rpx 24rpx 8rpx; }
.brand-row { display: flex; align-items: center; }
.brand-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--brand); margin-right: 10rpx; }
.brand-text { color: var(--brand); font-weight: 600; font-size: 30rpx; }
.tag { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }

.sec-title { font-size: 24rpx; color: var(--ink-3); margin: 24rpx 4rpx 12rpx; letter-spacing: 1rpx; }

.list { }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 18rpx; margin-bottom: 16rpx; }

.dish { display: flex; gap: 20rpx; align-items: flex-start; }
.dish-img { width: 168rpx; height: 168rpx; border-radius: 14rpx; background: var(--fill); flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.dish-img .img { width: 100%; height: 100%; display: block; }
.dish-img .ph { color: var(--ink-3); font-size: 22rpx; }
.dish-info { flex: 1; min-width: 0; }

.price { color: var(--ink); font-weight: 600; font-size: 30rpx; }
.price .unit { font-size: 20rpx; color: var(--ink-3); font-weight: 400; }
.stars { color: #E8833A; font-size: 24rpx; margin-top: 8rpx; letter-spacing: 2rpx; }
.muted { color: var(--ink-3); font-size: 22rpx; line-height: 1.4; }
