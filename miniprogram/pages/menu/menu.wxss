.topbar { padding: 12rpx 4rpx 20rpx; }
.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 14rpx; }
.thumb { width: 100%; height: 240rpx; border-radius: 12rpx; overflow: hidden; background: var(--fill); }
.img { width: 100%; height: 100%; display: block; }
.ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 24rpx; border: 1rpx dashed var(--line); }
.name { font-weight: 600; font-size: 28rpx; margin-top: 12rpx; }
.price { color: var(--ink); font-weight: 600; font-size: 28rpx; }
.star { color: #E8833A; font-size: 24rpx; }
.star .count { color: var(--ink-3); font-size: 20rpx; margin-left: 4rpx; }
.desc { color: var(--ink-3); font-size: 22rpx; margin-top: 8rpx; line-height: 1.4; }
