/* 顾客端店铺菜单 —— 对齐 design/menu-design.html 原型 */
.hero { padding: 28rpx 24rpx 8rpx; }
.brand-row { display: flex; align-items: center; }
.brand-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--brand); margin-right: 10rpx; }
.brand-text { color: var(--brand); font-weight: 600; font-size: 30rpx; }
.tag { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }

.sec-title { font-size: 24rpx; color: var(--ink-3); margin: 24rpx 4rpx 12rpx; letter-spacing: 1rpx; }

/* 店铺菜单双列网格：与首页同款 */
.menu-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.menu-card { width: calc(50% - 8rpx); background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; overflow: hidden; box-sizing: border-box; }
.menu-img-wrap { position: relative; width: 100%; padding-bottom: 125%; background: var(--fill); overflow: hidden; }
.menu-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.menu-img.ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 24rpx; border: 1rpx dashed var(--line); }
.menu-info { padding: 16rpx; }
.menu-name { font-size: 28rpx; font-weight: 600; line-height: 1.35; }
.menu-price { font-size: 26rpx; font-weight: 600; color: var(--brand); margin-top: 10rpx; }
