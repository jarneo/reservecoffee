.chat { display:flex; flex-direction:column; height:100vh; padding:0; }
.msgs { flex:1; padding:24rpx; box-sizing:border-box; }
.msg { display:flex; margin-bottom:20rpx; }
.msg.user { justify-content:flex-end; }
.msg.assistant { justify-content:flex-start; }
.bubble {
  max-width:78%;
  padding:18rpx 22rpx;
  border-radius:18rpx;
  font-size:28rpx;
  line-height:1.55;
  white-space:pre-wrap;
  word-break:break-word;
}
.msg.user .bubble { background:var(--ink); color:#fff; border-bottom-right-radius:6rpx; }
.msg.assistant .bubble { background:#fff; border:1rpx solid var(--line); border-bottom-left-radius:6rpx; }

.confirm { background:#fff; }
.confirm .sec { font-size:28rpx; font-weight:600; margin-bottom:14rpx; }
.ci { font-size:27rpx; padding:10rpx 0; border-bottom:1rpx solid var(--line); display:flex; }
.ci .ck { width:96rpx; color:var(--ink-3); flex:none; }

.down { background:#fff8ec; border:1rpx solid #f0d9a0; }
.down .sec { font-weight:600; }

.chips { display:flex; flex-wrap:wrap; gap:14rpx; padding:0 24rpx 12rpx; }
.chip {
  font-size:24rpx; color:var(--brand);
  border:1rpx solid var(--brand); border-radius:999rpx;
  padding:10rpx 20rpx;
}
.chip:active { background:rgba(122,82,48,.08); }

.inputbar {
  display:flex; align-items:center; gap:14rpx;
  padding:16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background:#fff; border-top:1rpx solid var(--line);
}
.inp {
  flex:1; height:72rpx;
  background:var(--fill); border-radius:12rpx;
  padding:0 22rpx; font-size:28rpx;
}
.btn.send { background:var(--ink); color:#fff; padding:0 30rpx; height:72rpx; line-height:72rpx; border-radius:12rpx; font-size:28rpx; }

.mask { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:center; justify-content:center; z-index:1000; }
.success { width:560rpx; background:#fff; border-radius:20rpx; padding:40rpx 36rpx; text-align:center; }
.success .big { font-size:38rpx; font-weight:700; }
