<view class="page chat">
  <scroll-view scroll-y class="msgs" scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="msg {{item.role}}">
      <view class="bubble {{item.notice?'notice':''}}">{{item.content}}</view>
    </view>

    <!-- 确认卡（复用已授权资料，不展示可编辑表单） -->
    <view wx:if="{{intent==='confirm'}}" class="card confirm">
      <view class="sec">预约确认</view>
      <view class="ci"><text class="ck">项目</text>{{confirmation.projectName}}</view>
      <view class="ci"><text class="ck">日期</text>{{confirmation.date}}</view>
      <view class="ci"><text class="ck">时段</text>{{confirmation.sessionStart}}–{{confirmation.sessionEnd}}</view>
      <view class="ci"><text class="ck">人数</text>{{confirmation.partySize}} 人位</view>
      <view class="ci muted xs">称呼：{{profile.name||'—'}}　手机：{{profile.phone||'—'}}（已复用您授权资料）</view>
      <button class="btn block" bindtap="confirm">确认预约</button>
      <view class="tap muted sm" bindtap="cancelConfirm" style="text-align:center;margin-top:14rpx">重新说 / 取消</view>
    </view>

    <!-- 降级提示卡（AI 不可用时） -->
    <view wx:if="{{downgraded}}" class="card down">
      <view class="sec">AI 助理暂不可用</view>
      <view class="muted sm" style="margin:10rpx 0 18rpx;line-height:1.6">可先使用常规预约，不影响您的操作。</view>
      <button class="btn block" bindtap="goBooking">进入常规预约</button>
    </view>
  </scroll-view>

  <!-- 快捷短语（仅在尚未进入确认/降级时展示）：来自后台「AI 预约 · 快捷短语」，点一下即发送 item.text -->
  <view class="chips" wx:if="{{!intent && !downgraded && quickReplies.length}}">
    <view wx:for="{{quickReplies}}" wx:key="_i" class="chip" bindtap="quick" data-q="{{item.text}}">{{item.label}}</view>
  </view>

  <!-- 隐私授权弹窗（录音属隐私接口，须先同步用户已同意《用户隐私保护指引》） -->
  <view wx:if="{{showPrivacy}}" class="pmask">
    <view class="pcard">
      <view class="ptitle">用户隐私保护提示</view>
      <view class="pbody">语音预约需要用到麦克风。使用前请先阅读并同意<text class="plink" bindtap="openPrivacyContract">{{privacyName}}</text>。点击同意后方可开启语音输入。</view>
      <button id="agree-btn" class="btn block" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意并开启语音</button>
      <view class="tap muted sm" bindtap="onDisagreePrivacy" style="text-align:center;margin-top:20rpx">不同意，用文字输入</view>
    </view>
  </view>

  <!-- 录音中：实时识别浮层 -->
  <view wx:if="{{recording}}" class="live">
    <view class="live-dot"></view>
    <view class="live-txt">{{liveText || '正在聆听…'}}</view>
  </view>

  <view class="inputbar">
    <!-- 左侧：语音 / 键盘 切换（微信聊天样式，插件不可用时自动隐藏） -->
    <view wx:if="{{pluginOk}}" class="icon-btn {{voiceMode ? 'kbd' : 'mic'}}" bindtap="toggleMode"></view>

    <input wx:if="{{!voiceMode}}" class="inp" value="{{draft}}" bindinput="onDraft" placeholder="说点什么，例如：明天 13点 2人法兰绒咖啡" confirm-type="send" bindconfirm="send"/>
    <view wx:else class="voice-btn {{recording ? 'on' : ''}}"
          bindtouchstart="onVoiceStart" bindtouchend="onVoiceEnd" bindtouchcancel="onVoiceEnd">
      {{recording ? '松开 发送' : '按住 说话'}}
    </view>

    <button wx:if="{{!voiceMode}}" class="btn send" bindtap="send">发送</button>
  </view>

  <!-- 提交成功覆盖层 -->
  <view wx:if="{{success}}" class="mask">
    <view class="success">
      <view class="big">{{successInfo.needReview ? '已提交，待审核' : '预约成功'}}</view>
      <view class="muted" style="margin:10rpx 0 4rpx">{{successInfo.projectName}}</view>
      <view class="muted sm">{{successInfo.date}}　{{successInfo.sessionStart}}–{{successInfo.sessionEnd}}　{{successInfo.partySize}}人位</view>
      <view class="btn block" bindtap="goMine" style="margin-top:24rpx">查看我的预约</view>
      <view class="tap muted sm" bindtap="closeSuccess" style="text-align:center;margin-top:14rpx">返回首页</view>
    </view>
  </view>
</view>
