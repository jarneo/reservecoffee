page { overflow-x: hidden; width: 100%; }
.hero { background:#fff; border:1rpx solid var(--line); border-radius:16rpx; padding:40rpx 28rpx; margin-bottom:24rpx; box-sizing: border-box; }
.hero .hero-img { width:100%; height:auto; display:block; border-radius:12rpx; margin-bottom:18rpx; background:var(--fill); }
.brand-row { display:flex; align-items:center; }
.brand-row .brand-text { font-size:34rpx; font-weight:700; margin-left:12rpx; letter-spacing:1rpx; }
.hero .tag { font-size:22rpx; color:var(--ink-3); margin-top:10rpx; letter-spacing:2rpx; }
.hero .intro { font-size:26rpx; color:var(--ink-2); margin-top:16rpx; line-height:1.6; white-space: pre-line; overflow-wrap: break-word; word-break: break-word; }
.sec-title { font-size:26rpx; color:var(--ink-3); margin:8rpx 4rpx 16rpx; }

/* 项目卡片：图标 + 内容 */
.proj-card { display:flex; gap:20rpx; align-items:flex-start; }
.proj-icon { width:120rpx; height:120rpx; border-radius:16rpx; flex:none; background:var(--fill); }
.proj-icon.ph { display:flex; align-items:center; justify-content:center; color:var(--ink-3); font-size:22rpx; border:1rpx dashed var(--line); }
.proj-body { flex:1; min-width:0; }
.proj-intro { margin-top:8rpx; }
.note { color:var(--ink-3); font-size:26rpx; text-align:center; padding:40rpx; }

/* 首页项目卡：可预约状态（位于描述上方） */
.bookinfo { display:flex; flex-wrap:wrap; align-items:center; gap:10rpx; margin-top:12rpx; }
.bookinfo .tag { font-size:22rpx; line-height:1; padding:6rpx 14rpx; border-radius:999rpx; font-weight:600; }
.bookinfo .tag.ok { color:#7A5230; background:rgba(122,82,48,.10); border:1rpx solid rgba(122,82,48,.25); }
.bookinfo .tag.paused { color:#b3261e; background:rgba(179,38,30,.08); border:1rpx solid rgba(179,38,30,.25); }
.bookinfo .tag.none { color:var(--ink-3); background:var(--fill); border:1rpx solid var(--line); }
.bookinfo .date-chip { font-size:22rpx; line-height:1; padding:6rpx 12rpx; border-radius:8rpx; color:var(--ink-2); background:var(--fill); border:1rpx solid var(--line); }
.bookinfo .more { font-size:22rpx; color:var(--ink-3); }

/* 店铺菜单（首页内联） */
.menu-card { display:flex; gap:20rpx; background:#fff; border:1rpx solid var(--line); border-radius:16rpx; padding:20rpx; margin-bottom:16rpx; }
.menu-img { width:160rpx; height:160rpx; border-radius:12rpx; flex:none; background:var(--fill); }
.menu-img.ph { display:flex; align-items:center; justify-content:center; color:var(--ink-3); font-size:22rpx; border:1rpx dashed var(--line); }
.menu-info { flex:1; min-width:0; display:flex; flex-direction:column; }
.menu-price { font-weight:600; font-size:28rpx; }

