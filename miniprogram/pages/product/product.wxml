<view class="page">
  <view class="hero">
    <image wx:if="{{product.imageUrl}}" class="hero-img" src="{{product.imageUrl}}" mode="widthFix"/>
    <view wx:else class="hero-ph">暂无图片</view>
  </view>

  <view class="card">
    <view class="name">{{product.name}}</view>
    <view class="price">{{product.priceText}}</view>
    <view class="star">{{product.stars}}<text class="count"> {{product.ratingCount||0}} 条评价</text></view>
    <view wx:if="{{product.desc}}" class="desc">{{product.desc}}</view>
  </view>

  <view class="sec">评价（{{reviews.length}}）</view>
  <view wx:if="{{reviews.length===0}}" class="note">还没有评价，快来抢沙发</view>
  <view wx:for="{{reviews}}" wx:key="_id" class="card rev">
    <view class="row between">
      <view class="ruser">
        <view class="ava">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="ava-img"/>
          <view wx:else class="ava-def">{{item.initial}}</view>
        </view>
        <view class="rname">{{item.name}}<text wx:if="{{item.top}}" class="top"> · 置顶</text></view>
      </view>
      <view class="star">{{item.stars}}</view>
    </view>
    <view class="rtext">{{item.text}}</view>
    <view wx:if="{{item.imagesUrl.length}}" class="rimg-row">
      <image wx:for="{{item.imagesUrl}}" wx:for-item="im" wx:key="*this" src="{{im}}" class="rimg" mode="aspectFill"/>
    </view>
    <view class="rtime">{{item.time}}</view>
  </view>

  <!-- 写评价 -->
  <view class="card post">
    <view class="sec">写评价</view>

    <!-- 未授权：仅显示入口按钮；已授权后表单直接展示，无需此入口；已拒绝则无提交入口 -->
    <button wx:if="{{!authorized && authState!=='denied'}}" class="btn block ghost" bindtap="onWrite">
      写评价（需授权微信头像与昵称）
    </button>
    <view wx:if="{{authState==='denied'}}" class="hint">你已拒绝授权，无法发表评价。评价需展示真实微信头像与昵称。</view>

    <!-- 已授权：实名头像/昵称已锁定，仅评分 + 文字 + 图片 + 提交 -->
    <block wx:if="{{authorized}}">
      <view class="idcard">
        <view class="ava sm">
          <image wx:if="{{pAvatar}}" src="{{pAvatar}}" class="ava-img"/>
          <view wx:else class="ava-def">{{pName.slice(0,1)}}</view>
        </view>
        <view class="idname">{{pName}}<text class="lock">微信实名</text></view>
      </view>

      <view class="stars-sel">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="sbtn {{rating>=item?'on':''}}" bindtap="setRating" data-n="{{item}}">★</text>
      </view>

      <view class="img-row">
        <view wx:for="{{images}}" wx:key="*this" class="img-wrap">
          <image src="{{item}}" class="img-thumb" mode="aspectFill"/>
          <view class="img-del" bindtap="removeImage" data-i="{{index}}">×</view>
        </view>
        <view wx:if="{{images.length<9}}" class="img-add" bindtap="chooseImage">+</view>
      </view>

      <textarea class="ta" placeholder="说说你的感受…" value="{{text}}" bindinput="onText" maxlength="300"/>
      <view class="privacy-line">提交即表示同意<text class="link" bindtap="openPrivacy">《隐私政策》</text>，评价将展示你的微信昵称与头像</view>
      <button class="btn block" bindtap="submit" disabled="{{posting}}">提交评价</button>
    </block>
  </view>

  <!-- 授权弹窗：头像 + 昵称一并授权，均来自微信且不可修改 -->
  <view wx:if="{{showAuth}}" class="modal-mask">
    <view class="modal">
      <view class="modal-title">授权微信头像与昵称</view>
      <view class="modal-body">为展示真实评价，需获取你的微信头像与微信昵称（均取自微信，不可修改，仅用于评价展示）。</view>

      <!-- 头像：chooseAvatar 仅取微信头像，不允许相册上传；获取后锁定不可改 -->
      <view class="auth-ava">
        <view class="ava lg">
          <image wx:if="{{pAvatar}}" src="{{pAvatar}}" class="ava-img"/>
          <view wx:else class="ava-def">头</view>
        </view>
        <block wx:if="{{pAvatar}}">
          <view class="locked">微信头像<text class="lock">已锁定</text></view>
        </block>
        <button wx:else class="btn ghost sm" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">获取微信头像</button>
      </view>

      <!-- 昵称：input type=nickname 取微信昵称；点键盘「使用微信昵称」即真实实名并立即锁定；手填失焦后亦锁定，不可再改 -->
      <view class="field row between">
        <view class="label">微信昵称</view>
        <block wx:if="{{nameLocked}}">
          <view class="locked">{{pName}}<text class="lock">已锁定</text></view>
        </block>
        <input wx:else class="nick" type="nickname" placeholder="点击后选『使用微信昵称』" value="{{pName}}" bindinput="onPName" bindblur="onNameBlur" bind:nicknamereview="onNickNameReview"/>
      </view>
      <view wx:if="{{!nameLocked}}" class="hint">点击输入框后，在键盘上选择「使用微信昵称」获取真实昵称；也可直接输入，选好后失焦即锁定</view>
      <view wx:if="{{nameLocked}}" class="resel" bindtap="resetName">重新选择昵称</view>

      <view class="modal-ops">
        <button class="btn ghost" bindtap="onAuthCancel">拒绝</button>
        <button class="btn" disabled="{{!(pAvatar && pName)}}" bindtap="onAuthConfirm">确认授权</button>
      </view>
    </view>
  </view>
</view>
