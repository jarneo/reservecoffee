.hero { width: 100%; height: 420rpx; background: var(--fill); border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; }
.hero-img { width: 100%; height: 100%; }
.hero-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--ink-3); border: 1rpx dashed var(--line); }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.name { font-weight: 600; font-size: 32rpx; }
.price { color: var(--ink); font-weight: 600; font-size: 30rpx; }
.star { color: #E8833A; font-size: 24rpx; margin-top: 8rpx; }
.star .count { color: var(--ink-3); font-size: 22rpx; }
.desc { color: var(--ink-2); font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }
.sec { font-size: 26rpx; color: var(--ink-3); margin: 8rpx 4rpx 12rpx; }
.rev .rname { font-weight: 600; font-size: 26rpx; }
.rev .top { color: var(--brand); }
.rev .rtext { font-size: 26rpx; color: var(--ink); margin-top: 8rpx; line-height: 1.6; }
.rev .rtime { font-size: 20rpx; color: var(--ink-3); margin-top: 8rpx; }
.stars-sel { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.sbtn { font-size: 48rpx; color: var(--line); }
.sbtn.on { color: #E8833A; }
.ta { width: 100%; height: 160rpx; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 14rpx; box-sizing: border-box; font-size: 26rpx; }
