.hero { width: 100%; height: 420rpx; background: var(--fill); border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; }
.hero-img { width: 100%; height: 100%; }
.hero-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--ink-3); border: 1rpx dashed var(--line); }
.card { background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.name { font-weight: 600; font-size: 32rpx; }
.price { color: var(--ink); font-weight: 600; font-size: 30rpx; }
.star { color: #E8833A; font-size: 24rpx; margin-top: 8rpx; }
.star .count { color: var(--ink-3); font-size: 22rpx; }
.desc { color: var(--ink-2); font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }
.sec { font-size: 26rpx; color: var(--ink-3); margin: 8rpx 4rpx 12rpx; }
.rev .ruser { display: flex; align-items: center; gap: 14rpx; }
.rev .rname { font-weight: 600; font-size: 26rpx; }
.rev .top { color: var(--brand); }
.rev .rtext { font-size: 26rpx; color: var(--ink); margin-top: 8rpx; line-height: 1.6; }
.rev .rtime { font-size: 20rpx; color: var(--ink-3); margin-top: 8rpx; }
.ava { width: 56rpx; height: 56rpx; border-radius: 50%; overflow: hidden; flex: none; background: var(--fill); }
.ava.sm { width: 48rpx; height: 48rpx; }
.ava-img { width: 100%; height: 100%; display: block; }
.ava-def { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--line); color: #fff; font-size: 24rpx; }
.field { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.field .label { font-size: 26rpx; color: var(--ink-2); }
.nick { text-align: right; font-size: 26rpx; }

/* 授权弹窗内：头像 + 昵称采集 */
.auth-ava { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.ava.lg { width: 96rpx; height: 96rpx; }
.locked { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; font-weight: 600; color: var(--ink); }
.lock { font-size: 20rpx; color: #1A7A3C; background: #E6F4EA; padding: 2rpx 12rpx; border-radius: 999rpx; font-weight: 400; }
.resel { font-size: 22rpx; color: var(--brand); margin-top: 8rpx; }

/* 写评价：已锁定实名卡片 */
.idcard { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); margin-bottom: 12rpx; }
.idname { font-size: 28rpx; font-weight: 600; color: var(--ink); display: flex; align-items: center; gap: 12rpx; }
.hint { font-size: 22rpx; color: var(--ink-3); margin: 8rpx 0; }
.stars-sel { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.sbtn { font-size: 48rpx; color: var(--line); }
.sbtn.on { color: #E8833A; }
.ta { width: 100%; height: 160rpx; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 14rpx; box-sizing: border-box; font-size: 26rpx; }

/* 评价图片（列表展示） */
.rimg-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.rimg { width: 140rpx; height: 140rpx; border-radius: 10rpx; }

/* 写评价：图片选择 */
.img-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 14rpx 0; }
.img-wrap { position: relative; width: 140rpx; height: 140rpx; border-radius: 10rpx; overflow: hidden; }
.img-thumb { width: 100%; height: 100%; }
.img-del { position: absolute; top: 0; right: 0; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; background: rgba(0,0,0,.5); color: #fff; font-size: 28rpx; }
.img-add { width: 140rpx; height: 140rpx; border: 1rpx dashed var(--line); border-radius: 10rpx; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 48rpx; }

/* 隐私说明与链接 */
.privacy-line { font-size: 22rpx; color: var(--ink-3); margin: 10rpx 0; line-height: 1.6; }
.privacy-line .link { color: var(--brand); }

/* 授权弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; z-index: 99; }
.modal { width: 560rpx; background: #fff; border-radius: 16rpx; padding: 32rpx; box-sizing: border-box; }
.modal-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.modal-body { font-size: 26rpx; color: var(--ink-2); line-height: 1.7; }
.modal-ops { display: flex; gap: 20rpx; margin-top: 28rpx; }
.modal-ops .btn { flex: 1; margin: 0; }
