<view class="page">
  <view class="card">
    <view class="bold">{{projectName}}</view>
    <view class="sm muted" style="margin-top:8rpx">{{date}} · {{session.start}} – {{session.end}}</view>
    <view class="sm muted">可约剩 {{session.remaining}} / {{session.capacity}}</view>
  </view>

  <view class="card">
    <view class="field"><view class="label">称呼</view><input type="nickname" placeholder="如何称呼您（可一键填入微信昵称）" value="{{name}}" bindinput="onName"/></view>

    <view class="field" wx:if="{{fields.indexOf('phone') >= 0}}">
      <view class="label">手机号（选填）</view>
      <view class="phone-row">
        <input class="phone-input" type="number" placeholder="用于通知与到店核验" value="{{phone}}" bindinput="onPhone"/>
        <button class="btn ghost sm get-phone" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">获取手机号</button>
      </view>
    </view>

    <view class="field" wx:if="{{fields.indexOf('wechat') >= 0}}"><view class="label">微信（选填）</view><input placeholder="微信号，方便联系" value="{{wechat}}" bindinput="onWechat"/></view>

    <view class="field row between" wx:if="{{fields.indexOf('gender') >= 0}}">
      <view class="label">性别（选填）</view>
      <input class="ta" style="text-align:right" placeholder="如 女" value="{{gender}}" bindinput="onGender"/>
    </view>

    <view class="field" wx:if="{{fields.indexOf('age') >= 0}}"><view class="label">年龄（选填）</view><input type="number" placeholder="如 28" value="{{age}}" bindinput="onAge"/></view>

    <view class="field row between">
      <view class="label">人数</view>
      <view class="stepper"><button bindtap="step" data-d="-1">−</button><view class="v">{{partySize}}</view><button bindtap="step" data-d="1">+</button></view>
      <view class="sm muted" style="margin-top:6rpx">单次最多 {{maxParty}} 人</view>
    </view>

    <view class="field" wx:if="{{fields.indexOf('note') >= 0}}"><view class="label">备注（选填）</view><textarea placeholder="如有特殊需求请告知店家" value="{{note}}" bindinput="onNote"/></view>
  </view>

  <button class="btn block" bindtap="submit">提交预约</button>
</view>
