.field.row { display:flex; align-items:center; justify-content:space-between; }

/* 手机号：输入框 + 微信一键获取按钮 */
.phone-row { display:flex; align-items:center; gap:16rpx; }
.phone-row .phone-input { flex:1; }
.phone-row .get-phone { margin:0; flex:none; font-size:24rpx; padding:0 22rpx; height:64rpx; line-height:64rpx; }

/* 黑名单阻断态：顶部警示块 + 禁用提交按钮 */
.bl-block {
  background: rgba(163, 45, 45, .07);
  border: 1rpx solid rgba(163, 45, 45, .25);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.bl-block .bl-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--danger);
}
.bl-block .bl-text {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}
.btn.blk-disabled {
  background: var(--fill);
  color: var(--ink-3);
  border-color: var(--line);
}

/* 提交按钮下方的说明（通知授权走微信原生弹窗，此处只做提示） */
.tip {
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

/* 提交成功页覆盖层（应用内必达确认 UI） */
.success-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}
.success-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 44rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, .18);
}
.success-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #7A5230;
}
.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink-1, #1a1a1a);
}
.success-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ink-3, #999);
  line-height: 1.6;
}
.success-detail {
  margin: 36rpx 0 24rpx;
  border-top: 1rpx solid var(--line, #eee);
  padding-top: 24rpx;
  text-align: left;
}
.sd-row {
  display: flex;
  justify-content: space-between;
  font-size: 27rpx;
  padding: 10rpx 0;
}
.sd-k { color: var(--ink-3, #999); }
.sd-v { color: var(--ink-1, #1a1a1a); }
.success-card .btn { margin-top: 16rpx; }
