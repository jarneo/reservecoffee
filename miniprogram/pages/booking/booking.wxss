.topbar { padding: 12rpx 4rpx 20rpx; display: flex; align-items: center; justify-content: space-between; }
.menu-link { color: var(--brand); font-size: 26rpx; }

/* 介绍图片区域（日历上方） */
.intro-area { margin-bottom: 20rpx; }
.intro-stack { display: flex; flex-direction: column; gap: 16rpx; }
.intro-item { position: relative; width: 100%; border-radius: 16rpx; overflow: hidden; background: var(--fill); border: 1rpx solid var(--line); }
.intro-img { width: 100%; height: auto; display: block; }
.intro-cap { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(26,26,26,.62); color: #fff; font-size: 22rpx; padding: 8rpx 14rpx; }
.intro-ph { background: #fff; border: 1rpx dashed var(--brand); border-radius: 16rpx; padding: 28rpx 26rpx; }
.intro-ph-t { color: var(--brand); font-weight: 600; font-size: 28rpx; margin-bottom: 10rpx; }
.intro-ph-d { color: var(--ink-2); font-size: 24rpx; line-height: 1.6; }

/* 横向日期条（两周 + 箭头翻页） */
.datestrip-wrap { display:flex; align-items:center; gap:12rpx; margin-bottom:8rpx; }
.dnav { flex:none; width:60rpx; height:60rpx; line-height:60rpx; text-align:center; border-radius:50%; border:1rpx solid var(--line); background:#fff; color:var(--ink-2); font-size:40rpx; }
.dnav:active { border-color:var(--ink); }
.dnav.disabled { opacity:.25; }
.datestrip { flex:1; white-space:nowrap; }
.dchip { display:inline-flex; flex-direction:column; align-items:center; width:112rpx; margin-right:16rpx; background:#fff; border:1rpx solid var(--line); border-radius:24rpx; padding:20rpx 0 16rpx; }
.dchip .wk { font-size:22rpx; color:var(--ink-3); line-height:1; }
.dchip .dd { font-size:34rpx; font-weight:600; margin-top:10rpx; line-height:1.1; }
.dchip .mo { font-size:20rpx; color:var(--ink-3); margin-top:4rpx; line-height:1; }
.dchip.off { background:var(--fill); color:var(--ink-3); }
.dchip.off .wk,.dchip.off .dd,.dchip.off .mo { color:var(--ink-3); }
.dchip.open { border-color:var(--ink); color:var(--ink); }
.dchip.open .wk { color:var(--ink-2); }
.dchip.today:not(.on) { box-shadow:0 0 0 2rpx var(--orange); border-color:transparent; }
.dchip.today:not(.on) .wk { color:var(--orange); font-weight:600; }
.dchip.on { background:var(--ink); border-color:var(--ink); color:#fff; }
.dchip.on .wk,.dchip.on .dd,.dchip.on .mo { color:#fff; }
/* 日期整体状态标签：暂停 / 满员 / 已过期 */
.dchip.st-paused { border-color:var(--ink-3); }
.dchip.st-full { border-color:var(--ink-3); }
.dchip.st-expired { border-color:#8a8f99; }
.chip-tag { margin-top:8rpx; font-size:20rpx; line-height:1; padding:4rpx 10rpx; border-radius:8rpx; }
.chip-tag.paused { color:#fff; background:var(--ink-3); }
.chip-tag.full { color:#fff; background:#b06a2c; }
.chip-tag.expired { color:#fff; background:#8a8f99; }
.range-label { font-size:22rpx; color:var(--ink-3); text-align:center; margin-top:4rpx; }

/* 项目整体暂停横幅 */
.pause-banner { background:var(--fill); color:var(--ink-2); border:1rpx dashed var(--ink-3); border-radius:12rpx; padding:18rpx 20rpx; font-size:26rpx; margin-bottom:16rpx; text-align:center; }

.biz { font-size:24rpx; color:var(--ink-2); padding:10rpx 4rpx 18rpx; }
.card.dis { opacity:.45; }
.note { color:var(--ink-3); font-size:26rpx; text-align:center; padding:36rpx; }
