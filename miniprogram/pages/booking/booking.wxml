<view class="page">
  <view class="topbar"><view class="bold">{{project.name}}</view></view>

  <view class="legend"><view class="dot ok"></view>可预约<view class="dot off"></view>不可预约</view>

  <view class="daygrid">
    <view wx:for="{{dayGrid}}" wx:key="y"
      class="daycell {{item.disabled?'off':''}} {{item.y===selectedDate?'on':''}}"
      bindtap="pickDay" data-y="{{item.y}}">
      <view class="dn">{{item.dayNum}}</view>
      <view class="dw">{{item.wd}}</view>
    </view>
  </view>

  <block wx:if="{{selectedDate}}">
    <view class="biz">今日营业 {{bizWindow || '暂未排场'}}</view>
    <view wx:if="{{sessions.length===0}}" class="note">该日暂未设置场次，请联系店家</view>
    <view wx:for="{{sessions}}" wx:key="id"
      class="card tap {{item.paused||item.remaining<=0?'dis':''}}"
      bindtap="pickSession" data-id="{{item.id}}">
      <view class="row between">
        <view class="bold">{{item.start}} – {{item.end}}</view>
        <view class="badge {{item.remaining<=0?'full':(item.paused?'paused':'ok')}}">{{item.paused?'已暂停':(item.remaining<=0?'已满':'剩 '+item.remaining+'/'+item.capacity)}}</view>
      </view>
      <view class="sm muted" style="margin-top:6rpx">{{item.paused?'本场已暂停':(item.remaining<=0?'人数已满':'点击选择该场次')}}</view>
    </view>
  </block>
  <view wx:else class="note">请选择上方可预约的日期</view>
</view>
