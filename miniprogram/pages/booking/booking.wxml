<view class="page">
    <view class="topbar">
      <view class="bold">{{project.name}}</view>
    </view>

    <view wx:if="{{project.paused}}" class="pause-banner">本项目已暂停预约，以下场次暂不可选</view>

    <!-- 介绍图片区域（日历上方）：图集画廊 / 占位「预约须知」 -->
  <view class="intro-area">
    <block wx:if="{{introImages.length}}">
      <view class="intro-stack">
        <view wx:for="{{introImages}}" wx:key="fileId" class="intro-item" bindtap="previewIntro" data-i="{{index}}">
          <image class="intro-img" src="{{item.url}}" mode="widthFix" bindload="onBootImg" binderror="onBootImg"/>
          <view wx:if="{{item.caption}}" class="intro-cap">{{item.caption}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="intro-ph">
      <view class="intro-ph-t">预约须知</view>
      <view class="intro-ph-d">请准时到店；如需取消请提前在「我的预约」操作。可约时间以日历开放日为准。</view>
    </view>
  </view>

  <!-- 关联项目：介绍区域延伸，点击可跳转至其他项目详情页（一对多） -->
  <view wx:if="{{relatedProjects.length}}" class="rel-card">
    <view class="rel-h"><text class="sec">关联项目</text><text class="muted">{{relatedProjects.length}}</text></view>
    <view class="rel-list">
      <view wx:for="{{relatedProjects}}" wx:key="_id" class="rel-item" bindtap="goRelated" data-id="{{item._id}}">
        <image wx:if="{{item.iconUrl}}" class="rel-icon" src="{{item.iconUrl}}" mode="aspectFill"/>
        <view wx:else class="rel-icon ph">图标</view>
        <view class="rel-info">
          <view class="rel-name">{{item.name}}</view>
          <view wx:if="{{item.intro}}" class="rel-desc">{{item.intro}}</view>
        </view>
        <view class="rel-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="datestrip-wrap">
    <view class="dnav {{canPrev?'':'disabled'}}" bindtap="moveDate" data-delta="-14">‹</view>
    <scroll-view scroll-x class="datestrip" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{dateChips}}" wx:key="ymd"
        class="dchip {{item.open?'open':''}} {{item.today?'today':''}} {{item.sel?'on':''}} {{item.open?'':'off'}} {{item.status?'st-'+item.status:''}}"
        data-ymd="{{item.ymd}}" bindtap="pickDate">
        <view class="wk">{{item.wk}}</view>
        <view class="dd">{{item.md}}</view>
        <view wx:if="{{item.status==='paused'}}" class="chip-tag paused">暂停</view>
        <view wx:elif="{{item.status==='full'}}" class="chip-tag full">满员</view>
        <view wx:elif="{{item.status==='expired'}}" class="chip-tag expired">已过期</view>
      </view>
    </scroll-view>
    <view class="dnav" bindtap="moveDate" data-delta="14">›</view>
  </view>
  <view class="range-label">{{dateRangeLabel}}</view>

  <block wx:if="{{selectedDate}}">
    <view class="biz">今日营业 {{bizWindow || '暂未排场'}}</view>
    <view wx:if="{{sessions.length===0}}" class="note">该日暂未设置场次，请联系店家</view>

    <!-- 场次选择：顾客与管理员共用。点选场次 → 页面底部展开内嵌表单（管理员亦可在此代客预约） -->
    <view class="secttl">选择场次</view>
    <view class="sess-grid">
      <view wx:for="{{sessions}}" wx:key="id"
        class="schip {{(item.paused||item.blocked||item.expired||item.remaining<=0)?'dis':''}} {{(selSession&&selSession.id===item.id)?'on':''}}"
        data-id="{{item.id}}" bindtap="selectSession">
        <view class="sc-time">{{item.start}}–{{item.end}}</view>
        <view wx:if="{{showSeatInfo}}" class="sc-badge {{item.expired?'b-exp':(item.remaining<=0?'b-full':((item.paused||item.blocked)?'b-pau':'b-ok'))}}">{{item.expired?'过期':(item.remaining<=0?'满':(item.paused||item.blocked?'暂停':('剩'+item.remaining)))}}</view><view wx:else class="sc-badge b-ok">可约</view>
      </view>
    </view>

    <!-- 内嵌确认表单：选中场次后出现于页面底部（顾客 + 管理员代客预约共用） -->
    <view wx:if="{{selSession}}" id="bookForm" class="book-form">
      <view wx:if="{{blocked}}" class="bl-block">
        <view class="bl-title">⚠ 暂时无法预约</view>
        <view class="bl-text">您的账号当前无法在线预约<text wx:if="{{blockReason}}">（{{blockReason}}）</text>。如有疑问，请直接联系店家沟通。</view>
      </view>

      <view wx:if="{{unavailable}}" class="bl-block">
        <view class="bl-title">⚠ 这个场次约不上了</view>
        <view class="bl-text">{{unavailable}}</view>
      </view>

      <view wx:if="{{!unavailable}}" class="card">
        <view class="bold">{{project.name}}</view>
        <view class="sm muted" style="margin-top:8rpx">{{selectedDate}} · {{selSession.start}} – {{selSession.end}}</view>
        <view wx:if="{{showSeatInfo}}" class="sm muted">可约剩 {{selSession.remaining}} / {{selSession.capacity}}</view>
      </view>

      <view wx:if="{{needFill && !unavailable && !blocked}}" class="need-fill">
        <view class="nf-title">还差一步就能确认</view>
        <view class="nf-text">称呼和手机号都是预约的必填项，缺一项无法提交。称呼聚焦后可直接使用微信昵称；手机号点「获取手机号」一键填入，也可以手工输入。手机号只会用于本次预约的通知。</view>
      </view>

      <view wx:if="{{!unavailable}}" class="card">
        <view class="field"><view class="label">称呼（必填）</view><input type="nickname" placeholder="如何称呼您（可一键填入微信昵称）" value="{{name}}" bindinput="onName"/></view>

        <view class="field" wx:if="{{showPhone}}">
          <view class="label">手机号（必填）</view>
          <view class="phone-row">
            <input class="phone-input" type="number" placeholder="仅用于本次预约的通知" value="{{phone}}" bindinput="onPhone"/>
            <button class="btn sm get-phone {{needFill ? '' : 'ghost'}}" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">获取手机号</button>
          </view>
        </view>

        <view class="field" wx:if="{{showWechat}}"><view class="label">微信（选填）</view><input placeholder="微信号，方便联系" value="{{wechat}}" bindinput="onWechat"/></view>

        <view class="field row between" wx:if="{{showGender}}">
          <view class="label">性别（选填）</view>
          <input class="ta" style="text-align:right" placeholder="如 女" value="{{gender}}" bindinput="onGender"/>
        </view>

        <view class="field" wx:if="{{showAge}}"><view class="label">年龄（选填）</view><input type="number" placeholder="如 28" value="{{age}}" bindinput="onAge"/></view>

        <view class="field row between">
          <view class="label">人数</view>
          <view class="stepper"><button bindtap="step" data-d="-1">−</button><view class="v">{{partySize}}</view><button bindtap="step" data-d="1">+</button></view>
          <view class="sm muted" style="margin-top:6rpx">单次最多 {{maxParty}} 人</view>
        </view>
        <view wx:if="{{partyCapped}}" class="cap-note">
          您选择的人数超过了单次上限，已按上限 {{partySize}} 位为您安排。如需更多位，请直接联系我们：vx / 电话 19292757851。
        </view>

        <view class="field" wx:if="{{showNote}}"><view class="label">备注（选填）</view><textarea placeholder="如有特殊需求请告知店家" value="{{note}}" bindinput="onNote"/></view>
      </view>

      <button wx:if="{{unavailable}}" class="btn block blk-disabled" disabled>场次已失效</button>
      <button wx:elif="{{blocked}}" class="btn block blk-disabled" disabled>无法预约</button>
      <button wx:else class="btn block" bindtap="submit">提交预约</button>

      <view class="tip">点「提交预约」后，微信会询问是否接收本单通知；未开启的项将改用短信通知您（需店家已开启短信）。</view>

      <!-- 提交成功页（应用内必达确认覆盖层） -->
      <view wx:if="{{success}}" class="success-mask">
        <view class="success-card">
          <view class="success-icon"></view>
          <view class="success-title">{{successInfo.needReview ? '提交成功，待审核' : '已为您留座'}}</view>
          <view class="success-sub">{{successInfo.needReview ? '店家审核通过后将发送预约成功通知' : '我们已收到您的预约，期待与您相见'}}</view>
          <view class="success-detail">
            <view class="sd-row"><text class="sd-k">项目</text><text class="sd-v">{{successInfo.projectName}}</text></view>
            <view class="sd-row"><text class="sd-k">日期</text><text class="sd-v">{{successInfo.date}}</text></view>
            <view class="sd-row"><text class="sd-k">场次</text><text class="sd-v" wx:if="{{successInfo.session}}">{{successInfo.session.start}} – {{successInfo.session.end}}</text></view>
            <view class="sd-row"><text class="sd-k">人数</text><text class="sd-v">{{successInfo.partySize}} 人</text></view>
          </view>
          <button class="btn block" bindtap="goMine">查看我的预约</button>
          <button class="btn ghost block" bindtap="closeSuccess">返回首页</button>
        </view>
      </view>
    </view>

    <!-- 管理员专属：本场预约人（分组视图，需求3）。点「进入预约管理」带日期跳到完整管理页 -->
    <view wx:if="{{isAdmin}}" class="admin-res">
      <view class="res-head">
        <view class="secttl" style="margin:0">当日预约情况</view>
        <view class="manage-link" bindtap="goManage">进入预约管理 ›</view>
      </view>
      <view wx:for="{{sessions}}" wx:key="id" class="sess-wrap">
        <view class="card">
          <view class="row between">
            <view class="bold">{{item.start}} – {{item.end}}</view>
            <view wx:if="{{showSeatInfo}}" class="badge {{item.expired?'expired':(item.remaining<=0?'full':((item.paused||item.blocked)?'paused':'ok'))}}">{{item.expired?'已过期':(item.remaining<=0?'已满':'剩 '+item.remaining+'/'+item.capacity)}}</view>
          </view>
          <view wx:if="{{showSeatInfo}}" class="sm muted" style="margin-top:6rpx">{{item.expired?'本场已过期':(item.paused||item.blocked?'本场已暂停':(item.remaining<=0?'人数已满':'可预约'))}}</view><view wx:else class="sm muted" style="margin-top:6rpx">{{item.expired?'本场已过期':(item.paused||item.blocked?'本场已暂停':'可预约')}}</view>
        </view>
        <reservee list="{{item.people}}" canCancel="{{item.cancelable}}" canReview="{{true}}" bind:cancel="onCancel" bind:review="onReview" />
      </view>
    </view>
  </block>
  <view wx:else class="note">请选择上方可预约的日期</view>

  <aiFab aiEnabled="{{aiEnabled}}" projectId="{{projectId}}" />

  <!-- 首屏加载遮罩：等 getProject + 日期条/默认选中日/场次列表三段串行渲染收敛 -->
  <page-loading show="{{booting}}" />
</view>

<path-bar />
