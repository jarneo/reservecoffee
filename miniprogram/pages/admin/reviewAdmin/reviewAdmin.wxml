<view class="page">
  <picker mode="selector" range="{{projects}}" range-key="name" bindchange="onProjectPick">
    <view class="card row between tap"><view class="bold">{{projectName || '选择项目'}}</view><view class="ma">切换 ›</view></view>
  </picker>

  <picker wx:if="{{productOptions.length}}" mode="selector" range="{{productOptions}}" range-key="name" bindchange="onProductPick">
    <view class="card row between tap"><view class="bold">菜品：{{productName || '请选择'}}</view><view class="ma">切换 ›</view></view>
  </picker>

  <view class="tabs">
    <view class="tab {{tab==='pending'?'on':''}}" bindtap="onTab" data-t="pending">待审核{{pendingCount? '('+pendingCount+')' : ''}}</view>
    <view class="tab {{tab==='all'?'on':''}}" bindtap="onTab" data-t="all">全部</view>
  </view>

  <view wx:if="{{reviews.length===0}}" class="note">{{tab==='pending' ? '暂无待审核评价' : '该菜品暂无评价'}}</view>
  <view wx:for="{{reviews}}" wx:key="_id" class="card">
    <view class="row between">
      <view class="ruser">
        <view class="ava">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="ava-img"/>
          <view wx:else class="ava-def">{{item.initial}}</view>
        </view>
        <view class="rname">{{item.name}}<text class="badge {{item.pending?'wait':'ok'}}">{{item.statusText}}</text></view>
        <view wx:if="{{item.productName}}" class="rprod">{{item.productName}}</view>
      </view>
      <view class="star">{{item.stars}}</view>
    </view>
    <view class="rtext">{{item.text}}</view>
    <view wx:if="{{item.imagesUrl.length}}" class="rimg-row">
      <image wx:for="{{item.imagesUrl}}" wx:for-item="im" wx:key="*this" src="{{im}}" class="rimg" mode="aspectFill"/>
    </view>
    <view class="rtime">{{item.time}}<text wx:if="{{item.status==='hidden'}}" class="hidden"> · 已隐藏</text></view>

    <view class="ops" wx:if="{{item.pending}}">
      <button class="btn-act ok" bindtap="approve" data-i="{{index}}">通过</button>
      <button class="btn-act danger" bindtap="reject" data-i="{{index}}">拒绝</button>
    </view>
    <view class="ops" wx:else>
      <text class="ob" bindtap="toggleTop" data-i="{{index}}">{{item.top ? '取消置顶' : '置顶'}}</text>
      <text class="ob" bindtap="toggleHide" data-i="{{index}}">{{item.status==='hidden' ? '显示' : '隐藏'}}</text>
      <text class="ob danger" bindtap="del" data-i="{{index}}">删除</text>
    </view>
  </view>
</view>
