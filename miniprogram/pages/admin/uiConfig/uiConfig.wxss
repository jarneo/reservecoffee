.banner { background:#fff8ec; border:1rpx solid #f0d9a0; color:#8a6d1d; font-size:23rpx; padding:16rpx 18rpx; border-radius:12rpx; margin-bottom:16rpx; line-height:1.6; }
.sec { font-size:28rpx; font-weight:600; color:var(--ink); margin-bottom:14rpx; }
.fld { padding:16rpx 0; }
.fld.row.between { display:flex; align-items:center; justify-content:space-between; }
.fld-txt { flex:1; padding-right:24rpx; }
.label { font-size:26rpx; color:var(--ink); }
.tip { margin-top:6rpx; line-height:1.7; }
