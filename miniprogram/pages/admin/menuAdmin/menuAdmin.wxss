.sec { font-size: 26rpx; color: var(--ink-3); }
.ma { color: var(--ink-3); }
.thumb { width: 88rpx; height: 88rpx; border-radius: 12rpx; overflow: hidden; background: rgba(122,82,48,.08); border: 1rpx solid rgba(122,82,48,.18); margin-right: 16rpx; flex: none; }
.img { width: 100%; height: 100%; }
.ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 22rpx; }
.price { font-weight: 600; font-size: 28rpx; margin-top: 6rpx; }
.ops { display: flex; flex-direction: column; gap: 14rpx; align-items: flex-end; }
.ob { color: var(--brand); font-size: 26rpx; }
.ob.danger { color: #B23A3A; }
.up { width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; background: var(--fill); border: 1rpx dashed var(--line); }
.up-img { width: 100%; height: 100%; }
.up-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--ink-3); font-size: 26rpx; }
.field { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.field .label { font-size: 24rpx; color: var(--ink-3); margin-bottom: 8rpx; }
