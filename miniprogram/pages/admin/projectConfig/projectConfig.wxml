<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="page">
  <picker mode="selector" range="{{projects}}" range-key="name" bindchange="onProjectPick">
    <view class="card row between tap"><view class="bold">{{projectName || (project?project.name:'选择项目')}}</view><view class="ma">切换 ›</view></view>
  </picker>

  <!-- 项目首页描述：顾客端首页该项目卡片下方文字，可自定义（替代固定占位文案） -->
  <view class="card">
    <view class="sec">项目首页描述</view>
    <view class="tip" style="text-align:left;margin-top:0;margin-bottom:10rpx">展示在顾客端首页该项目卡片下方，可随时修改，保存后立即生效（≤300 字）。</view>
    <textarea class="ta" value="{{intro}}" placeholder="如：每日限量手冲深烘，安静的吧台座位。" bindinput="onIntro" maxlength="300" auto-height/>
    <view class="tip" style="text-align:right;margin-top:6rpx">{{intro.length}}/300</view>
  </view>

  <!-- 项目图标：顾客端首页项目卡片左侧展示 -->
  <view class="card">
    <view class="sec">项目图标</view>
    <view class="tip" style="text-align:left;margin-top:0;margin-bottom:10rpx">显示在顾客端首页「预约项目」列表左侧；不上传则显示默认占位。</view>
    <view class="icon-row">
      <image wx:if="{{iconUrl}}" class="icon-preview" src="{{iconUrl}}" mode="aspectFill"/>
      <view wx:else class="icon-preview ph">图标</view>
      <view class="icon-acts">
        <button class="btn sm" bindtap="pickIcon">{{iconFileId?'替换':'上传'}}</button>
        <button wx:if="{{iconFileId}}" class="btn sm ghost" bindtap="clearIcon">删除</button>
      </view>
    </view>
    <view class="tip">建议正方形，120×120px 以上，单张 ≤1MB。</view>
  </view>

  <!-- 介绍图片：上传 / 替换 / 删除 / 排序 / 说明 -->
  <view class="card">
    <view class="sec row between">
      <view>介绍图片（预约页展示）</view>
      <view class="muted">{{introImages.length}}/9</view>
    </view>
    <view class="img-grid">
      <view wx:for="{{introImages}}" wx:key="fileId" class="img-cell">
        <image class="img-thumb" src="{{item.url||item.fileId}}" mode="aspectFill"/>
        <view class="img-mask">
          <view class="img-btns">
            <text class="img-btn" catchtap="replaceImage" data-i="{{index}}">替换</text>
            <text class="img-btn" catchtap="deleteImage" data-i="{{index}}">删除</text>
          </view>
          <view class="img-move">
            <text class="img-btn" catchtap="moveImage" data-i="{{index}}" data-d="-1">↑</text>
            <text class="img-btn" catchtap="moveImage" data-i="{{index}}" data-d="1">↓</text>
          </view>
        </view>
      </view>
      <view wx:if="{{introImages.length<9}}" class="img-add" bindtap="addImages">＋<view class="xs muted">添加</view></view>
    </view>
    <view wx:if="{{introImages.length}}" class="img-caps">
      <view wx:for="{{introImages}}" wx:key="fileId" class="field">
        <view class="label">第 {{index+1}} 张说明（可选）</view>
        <input value="{{item.caption}}" placeholder="如：店内环境 / 出品特写" bindinput="onCaption" data-i="{{index}}"/>
      </view>
      <button class="btn block" bindtap="saveCaptions">保存说明文字</button>
    </view>
    <view class="tip">图片存于云存储，删除会同步清理云文件，避免孤儿文件。</view>
    <view class="tip">建议竖图：宽 750px（高清可 1080px），单张 ≤1MB，最多 9 张；按添加顺序在预约页全宽纵向展示，长图不会被裁切。</view>
  </view>

  <!-- ③ 全局设定 -->
  <view class="card" style="margin-top:0">
    <view class="sec">全局设定</view>
    <view class="field row between tap" bindtap="openCutoff">
      <view class="label">预约截止规则</view>
      <view class="val">{{cutoffText}} ›</view>
    </view>
    <view class="field row between tap" bindtap="openFields">
      <view class="label">提交预约信息设置</view>
      <view class="val">{{fieldsText}} ›</view>
    </view>
    <view class="field row between"><view class="label">提交后是否审核</view><switch checked="{{global.needReview}}" bindchange="gReview"/></view>
    <view class="field row between"><view class="label">每日预约次数上限</view>
      <view class="stepper"><button bindtap="stepDaily" data-d="-1">−</button><view class="v">{{global.dailyLimit}}</view><button bindtap="stepDaily" data-d="1">+</button></view>
    </view>
    <view class="field row between"><view class="label">预约提前开放天数</view>
      <view class="stepper"><button bindtap="stepAdv" data-d="-1">−</button><view class="v">{{global.advanceDays}}</view><button bindtap="stepAdv" data-d="1">+</button></view>
    </view>
    <view class="field row between"><view class="label">单次预约人数上限</view>
      <view class="stepper"><button bindtap="stepMax" data-d="-1">−</button><view class="v">{{global.maxParty}}</view><button bindtap="stepMax" data-d="1">+</button></view>
    </view>
    <view class="field row between"><view class="label">开启短信通知（预约成功时推送）</view><switch checked="{{global.smsEnabled}}" bindchange="gSms"/></view>
    <view class="field row between"><view class="label">开启订阅消息通知（预约状态推送给预订人 / 管理员）</view><switch checked="{{global.subscribeNotify}}" bindchange="gSub"/></view>
    <view class="field row between"><view class="label">预约页显示剩余/已约座位信息</view><switch checked="{{global.showSeatInfo}}" bindchange="gSeat"/></view>
  </view>

  <!-- ① 项目时间设置：直接点选日期切换可约/不可约 -->
  <view class="card">
    <view class="sec">项目时间设置</view>
    <calendar openDays="{{openDays}}" year="{{year}}" month="{{month}}" bind:select="onCalSelect"/>
    <view class="tip">点击日期即可切换「可约 / 不可约」，可多选；橘色圈为今天。</view>
  </view>

  <!-- ② 按开放日期展开每日场次 -->
  <view class="sec" style="margin:4rpx 4rpx 10rpx">已开放日期 · 场次（{{openDays.length}}）</view>
  <view wx:if="{{dayList.length===0}}" class="note">先在上方日历勾选可约日期，再为每日添加场次。</view>
  <view class="dayblock" wx:for="{{dayList}}" wx:key="date">
    <view class="dh">
      <view class="dt">{{item.label}} <view class="badge {{item.closed?'paused':'ok'}}">{{item.closed?'已暂停':'开放'}}</view></view>
      <view class="ops">
        <view class="pause-toggle">
          <text class="muted xs">{{item.closed?'暂停中':'可预约'}}</text>
          <switch checked="{{item.closed}}" color="#E8833A" bindchange="onDayPause" data-d="{{item.date}}"/>
        </view>
        <button class="btn ghost sm" data-d="{{item.date}}" bindtap="openAdd">+ 添加</button>
        <button class="btn ghost sm" data-d="{{item.date}}" bindtap="openTpl">模版</button>
        <button class="btn ghost sm" data-d="{{item.date}}" bindtap="openCopy">复制</button>
        <button class="btn ghost sm" data-d="{{item.date}}" bindtap="clearDay">清空</button>
      </view>
    </view>
    <sessionCard wx:for="{{item.sessions}}" wx:for-item="s" wx:key="id"
      session="{{s}}" canChangeCap="{{false}}" showPause="{{false}}" showCancel="{{false}}" data-date="{{item.date}}" bind:op="onSessionOp"/>
    <view wx:if="{{item.sessions.length===0}}" class="empty">暂无场次，点「模版」快速套用</view>
  </view>

  <!-- 底部统一保存：保存整个项目的配置信息 -->
  <button class="btn block" bindtap="saveAll">保存</button>

  <!-- 添加场次：屏幕居中弹层 -->
  <view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeAdd">
    <view class="modal" catchtap="noop">
      <view class="modal-t">添加场次 · {{addDate}}</view>
      <view class="field row between"><view class="label">开始</view>
        <picker mode="time" value="{{addForm.start}}" bindchange="onAddStart"><view class="picker">{{addForm.start}}</view></picker>
      </view>
      <view class="field row between"><view class="label">结束</view>
        <picker mode="time" value="{{addForm.end}}" bindchange="onAddEnd"><view class="picker">{{addForm.end}}</view></picker>
      </view>
      <view class="field row between"><view class="label">人数(默认8)</view>
        <view class="row" style="gap:12rpx">
          <view class="chip {{addForm.capacity===6?'on':''}}" bindtap="onAddCapQuick" data-c="6">6</view>
          <view class="chip {{addForm.capacity===8?'on':''}}" bindtap="onAddCapQuick" data-c="8">8</view>
          <input type="number" style="width:130rpx;text-align:right" value="{{addForm.capacity}}" bindinput="onAddCap"/>
        </view>
      </view>
      <view class="row" style="gap:12rpx;margin-top:16rpx">
        <button class="btn ghost block" bindtap="closeAdd">取消</button>
        <button class="btn block" bindtap="confirmAdd">保存</button>
      </view>
    </view>
  </view>

  <!-- 预约截止规则：屏幕居中弹层（新模型：开始前/开始后 N 分钟） -->
  <view class="modal-mask" wx:if="{{showCutoff}}" bindtap="closeCutoff">
    <view class="modal" catchtap="noop">
      <view class="modal-t">预约截止规则</view>
      <view class="field row between">
        <view class="label">截止基准</view>
        <view class="row" style="gap:12rpx">
          <view class="chip {{cutoffDraft.mode==='before'?'on':''}}" bindtap="onCutoffMode" data-m="before">场次开始前</view>
          <view class="chip {{cutoffDraft.mode==='after'?'on':''}}" bindtap="onCutoffMode" data-m="after">场次开始后</view>
        </view>
      </view>
      <view class="field row between">
        <view class="label">分钟数（可填）</view>
        <view class="row" style="gap:12rpx">
          <view class="chip {{cutoffDraft.minutes===30?'on':''}}" bindtap="onCutoffMin" data-m="30">30</view>
          <view class="chip {{cutoffDraft.minutes===60?'on':''}}" bindtap="onCutoffMin" data-m="60">60</view>
          <input type="number" style="width:130rpx;text-align:right" value="{{cutoffDraft.minutes}}" bindinput="onCutoffMinutes"/>
        </view>
      </view>
      <view class="tip" style="text-align:left;margin-top:4rpx">「开始前 N 分钟」：到点即停止预约；「开始后 N 分钟」：开赛后仍可继续预约一段时间。</view>
      <view class="row" style="gap:12rpx;margin-top:16rpx">
        <button class="btn ghost block" bindtap="closeCutoff">取消</button>
        <button class="btn block" bindtap="saveCutoff">保存</button>
      </view>
    </view>
  </view>

  <!-- 提交预约信息设置：屏幕居中弹层 -->
  <view class="modal-mask" wx:if="{{showFields}}" bindtap="closeFields">
    <view class="modal" catchtap="noop">
      <view class="modal-t">提交预约信息设置</view>
      <view class="tip" style="text-align:left;margin-top:0;margin-bottom:8rpx">勾选顾客预约时需填写的信息；姓名、手机号默认开启，可在此关闭（姓名始终收集，手机号选填）。</view>
      <view wx:for="{{fieldCatalog}}" wx:key="key" class="field row between">
        <view class="label">{{item.label}}</view>
        <switch checked="{{tools.indexOf(fieldsDraft, item.key) >= 0}}" bindchange="toggleField" data-k="{{item.key}}"/>
      </view>
      <view class="row" style="gap:12rpx;margin-top:16rpx">
        <button class="btn ghost block" bindtap="closeFields">取消</button>
        <button class="btn block" bindtap="saveFields">保存</button>
      </view>
    </view>
  </view>
</view>
