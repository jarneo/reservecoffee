.sec { font-size:26rpx; color:var(--ink-3); margin-bottom:14rpx; }
.ma { color:var(--ink-3); }
.tip { font-size:22rpx; color:var(--ink-3); text-align:center; margin-top:14rpx; }
.note { color:var(--ink-3); text-align:center; padding:30rpx; }

/* 介绍图片管理 */
.img-grid { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:6rpx; }
.img-cell { position:relative; width:160rpx; height:160rpx; border-radius:12rpx; overflow:hidden; border:1rpx solid var(--line); background:var(--fill); }
.img-thumb { width:100%; height:100%; display:block; }
.img-mask { position:absolute; inset:0; background:rgba(26,26,26,.42); opacity:0; transition:opacity .15s; display:flex; flex-direction:column; justify-content:space-between; padding:10rpx; }
.img-cell:active .img-mask, .img-cell .img-mask { opacity:1; }
.img-btns { display:flex; justify-content:space-between; }
.img-move { display:flex; justify-content:space-between; }
.img-btn { color:#fff; font-size:22rpx; background:rgba(0,0,0,.35); border-radius:8rpx; padding:4rpx 12rpx; }
.img-add { width:160rpx; height:160rpx; border:1rpx dashed var(--line); border-radius:12rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--ink-3); font-size:48rpx; }
.img-caps { margin-top:14rpx; }

/* 店铺主图 + 介绍 */
.cover-row { display:flex; align-items:center; gap:18rpx; }
.cover-img { width:200rpx; height:200rpx; border-radius:12rpx; object-fit:cover; background:var(--fill); border:1rpx solid var(--line); flex:none; }
.cover-ph { width:200rpx; height:200rpx; border:1rpx dashed var(--line); border-radius:12rpx; display:flex; align-items:center; justify-content:center; color:var(--ink-3); font-size:24rpx; background:var(--fill); flex:none; }
.cover-acts { display:flex; flex-direction:column; gap:12rpx; }
.ta { width:100%; min-height:160rpx; box-sizing:border-box; border:1rpx solid var(--line); border-radius:12rpx; padding:16rpx; font-size:26rpx; line-height:1.6; background:#fff; color:var(--ink); }

/* 每日场次块 */
.dayblock { border:1rpx solid var(--line); border-radius:12rpx; padding:14rpx; margin-bottom:12rpx; background:#fff; }
.dayblock .dh { display:flex; align-items:center; justify-content:space-between; margin-bottom:8rpx; }
.dayblock .dh .dt { font-weight:600; font-size:28rpx; }
.pill { font-size:20rpx; color:var(--brand); border:1rpx solid var(--brand); border-radius:999rpx; padding:2rpx 12rpx; }
.empty { color:var(--ink-3); font-size:22rpx; padding:8rpx 0; }
.ops { display:flex; gap:12rpx; margin-top:10rpx; }
.ops .btn { margin:0; }
/* 操作按钮行移入日期表头(.dh)时：去掉上间距，与设计稿一致右对齐 */
.dayblock .dh .ops { margin-top:0; gap:16rpx; }
/* 按天暂停开关：文字在上、开关在下，紧凑排布 */
.pause-toggle { display:flex; flex-direction:column; align-items:flex-end; justify-content:center; line-height:1.1; margin-right:2rpx; }
.pause-toggle .xs { font-size:20rpx; margin-bottom:2rpx; }

/* 添加场次：屏幕居中弹层 */
.modal-mask { position:fixed; inset:0; background:rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; z-index:100; }
.modal { width:78%; background:#fff; border-radius:16rpx; padding:28rpx; }
.modal-t { font-weight:600; font-size:30rpx; text-align:center; margin-bottom:18rpx; }
.picker { font-size:28rpx; text-align:right; color:var(--ink); }

/* 全局设定中的可点击行 + 行末值 */
.field.row.between.tap { padding: 20rpx 0; }
.val { color: var(--ink-3); font-size: 26rpx; }
.chip { padding:10rpx 24rpx; border:1rpx solid var(--line); border-radius:999rpx; font-size:24rpx; }
.chip.on { border-color:var(--ink); font-weight:600; }
