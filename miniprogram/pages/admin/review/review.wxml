<view class="page">
  <view class="row between" style="align-items:center;margin-bottom:8rpx">
    <view class="sec" style="padding:0">待审核预约（{{list.length}}）</view>
    <button class="btn sm" bindtap="reviewAll" wx:if="{{list.length>0}}">全部审核</button>
  </view>
  <view wx:if="{{list.length===0}}" class="note">暂无待审核预约</view>
  <view wx:for="{{list}}" wx:key="_id" class="card">
    <view class="row between"><view class="bold">{{item.name}}</view><view class="badge paused">待审核</view></view>
    <view class="sm muted" style="margin-top:6rpx">{{item.projectName}} · {{item.date}} {{item.time}} · {{item.partySize}} 人</view>
    <view class="sm muted">电话：{{item.phone}}</view>
    <view wx:if="{{item.note}}" class="xs" style="margin-top:6rpx">备注：{{item.note}}</view>
    <view class="row" style="margin-top:16rpx;gap:16rpx">
      <button class="btn sm" bindtap="approve" data-id="{{item._id}}">通过</button>
      <button class="btn ghost sm" bindtap="reject" data-id="{{item._id}}">拒绝</button>
    </view>
  </view>
</view>
