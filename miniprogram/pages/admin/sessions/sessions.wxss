.chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:16rpx; }
.chip { padding:10rpx 20rpx; border:1rpx solid var(--line); border-radius:999rpx; font-size:24rpx; }
.chip.on { border-color:var(--ink); font-weight:600; }
.ma { color:var(--ink-3); }
.note { color:var(--ink-3); text-align:center; padding:30rpx; }
.tip { font-size:22rpx; color:var(--ink-3); text-align:center; margin-top:20rpx; }
