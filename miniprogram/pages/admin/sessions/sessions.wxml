<view class="page">
  <picker mode="selector" range="{{projects}}" range-key="name" bindchange="onPick">
    <view class="card row between tap"><view class="bold">{{projectName || '选择项目'}}</view><view class="ma">切换 ›</view></view>
  </picker>

  <view class="datestrip-wrap">
    <view class="dnav {{canPrev?'':'disabled'}}" bindtap="moveDate" data-delta="-14">‹</view>
    <scroll-view scroll-x class="datestrip" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{dateChips}}" wx:key="ymd"
        class="dchip {{item.has?'open':''}} {{item.today?'today':''}} {{item.sel?'on':''}} {{item.has?'':'off'}}"
        data-ymd="{{item.ymd}}" bindtap="onDate">
        <view wx:if="{{item.mo}}" class="mo">{{item.mo}}</view>
        <view class="wk">{{item.wk}}</view>
        <view class="dd">{{item.dd}}</view>
      </view>
    </scroll-view>
    <view class="dnav" bindtap="moveDate" data-delta="14">›</view>
  </view>
  <view class="range-label">{{dateRangeLabel}}</view>

  <view wx:if="{{selDate}}">
    <view wx:if="{{sessions.length===0}}" class="note">该日暂无场次</view>
    <!-- 选中日期即一次性展开当日全部场次，预约人列表直接挂在对应场次下（无需点击） -->
    <view wx:for="{{sessions}}" wx:key="id" class="scard-wrap">
      <sessionCard session="{{item}}" canChangeCap="{{canChangeCap}}" showCancel="{{false}}" bind:op="onOp"/>
      <reservee list="{{item.people}}" canCancel="{{item.cancelable}}" canReview="{{true}}" bind:cancel="onCancel" bind:review="onReview" />
    </view>
  </view>
  <view wx:else class="note">请选择上方有场次的日期</view>

  <view class="tip">选中日期即展开当日全部场次，预约人直接列在对应场次下：可取消、审核（通过/不通过）、点开看详情并拨号。场次卡片上可暂停、改名额、取消全部。</view>
</view>

<path-bar />
