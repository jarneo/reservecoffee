.sec { font-size: 26rpx; color: var(--ink-3); margin-bottom: 14rpx; }
.name { font-size: 36rpx; font-weight: 600; color: var(--ink); }
.chip-phone {
  font-size: 24rpx; color: var(--ink-2); background: var(--fill);
  border: 1rpx solid var(--line); border-radius: 999rpx; padding: 6rpx 18rpx;
}
.danger { color: var(--danger); }

.editbox { margin-top: 20rpx; border-top: 1rpx solid var(--line); padding-top: 8rpx; }
/* 编辑区改用框式输入（.f-inp/.f-ta 自带全边框）→ 去掉 .field 的下划线，避免「框 + 底线」双线叠加 */
.editbox .field { border-bottom: none; }

.kpi-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.kpi-grid .kpi { width: calc(50% - 8rpx); box-sizing: border-box; }
.sm-num { font-size: 30rpx !important; }

.bar-row { display: flex; align-items: center; margin-bottom: 14rpx; }
.bar-name { width: 200rpx; font-size: 24rpx; color: var(--ink-2); flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-track { flex: 1; height: 16rpx; background: var(--fill); border-radius: 999rpx; overflow: hidden; }
.bar-fill { height: 100%; background: var(--brand); border-radius: 999rpx; }
.bar-cnt { width: 60rpx; text-align: right; font-size: 22rpx; color: var(--ink-3); flex-shrink: 0; }

.tagrow { display: flex; flex-wrap: wrap; }
.tag.fill.rm { cursor: pointer; }
/* 外观（背景/边框/圆角/内边距/字号/高度）已统一交给公共 .f-inp.sm，这里只留布局职责 */
.tag-input { flex: 1; min-width: 0; }
/* 让「添加」按钮与输入框严格等高（.btn.sm 默认由内容撑开 ≈58rpx，.f-inp.sm = 64rpx），
   仅作用于这一行，不给全局 .btn.sm 定高以免影响其他页面现有按钮。 */
.tagadd .btn.sm { height: 64rpx; padding: 0 20rpx; line-height: 38rpx; }

.rev-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.rev-row:last-child { border-bottom: none; }
.empty { text-align: center; padding: 60rpx 0; color: var(--ink-3); }
