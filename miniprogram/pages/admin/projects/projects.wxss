.chip { padding:10rpx 24rpx; border:1rpx solid var(--line); border-radius:999rpx; margin-right:12rpx; font-size:24rpx; }
.chip.on { border-color:var(--ink); font-weight:600; }
.note { color:var(--ink-3); text-align:center; padding:40rpx; }

/* 操作按钮行：与设计稿 second-design.html 的 .ops 对齐 */
.ops { display:flex; gap:16rpx; margin-top:16rpx; flex-wrap:wrap; }
.ops .btn { margin:0; }

/* 改名弹出层：底部抽屉（与 menuAdmin 一致） */
.modal-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 50; display: flex; align-items: flex-end; }
.modal-panel { width: 100%; max-height: 88vh; background: #fff; border-radius: 24rpx 24rpx 0 0; display: flex; flex-direction: column; overflow: hidden; }
.modal-bar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; border-bottom: 1rpx solid var(--line); }
.modal-x { font-size: 38rpx; color: var(--ink-3); padding: 0 12rpx; line-height: 1; }
.modal-body { max-height: 78vh; padding: 12rpx 28rpx 32rpx; box-sizing: border-box; }
.modal-body .btn.block { margin-top: 28rpx; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.modal-actions .btn.block { flex: 1; margin-top: 0; }
.btn.ghost { background: #fff; color: var(--brand); border: 1rpx solid var(--brand); }
.btn.ghost:active { background: rgba(122, 82, 48, .08); }
