.sec { font-size: 26rpx; color: var(--ink-3); margin-bottom: 14rpx; }
.chip-phone {
  font-size: 24rpx; color: var(--ink-2); background: var(--fill);
  border: 1rpx solid var(--line); border-radius: 999rpx; padding: 6rpx 18rpx;
}
/* .search-input 已上提到 app.wxss 的公共 .f-inp（两页原先各写一份同样规则，易漂移） */
.res-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.res-row:last-child { border-bottom: none; }
