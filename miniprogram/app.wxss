/* app.wxss — 黑白极简设计令牌 + 一抹品牌色点缀（暖咖棕 #7A5230） */
page {
  --ink: #1A1A1A;          /* 主墨色 文字/描边 */
  --ink-2: #555555;        /* 次级文字 */
  --ink-3: #999999;        /* 弱化文字 */
  --line: #E7E7E7;         /* 分割线 */
  --fill: #F5F5F5;         /* 浅灰填充 */
  --fill-2: #FAFAFA;
  --brand: #7A5230;        /* 品牌色（仅点缀，不参与状态表达） */
  --ok: #1A1A1A;
  --warn: #8A6D3B;
  --orange: #E8833A;       /* 仅用于标记「今天」 */
  --danger: #A32D2D;      /* 警示红（仅黑名单等阻断态使用，破例） */

  background: var(--fill-2);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 布局 */
/* ⚠️ 全局 border-box：微信默认 content-box，.page 的 padding 会撑出 48rpx 横向溢出 → 首页左右拖动/底部横滚动条。
   此项从根上消除 padding/border 导致的宽度超出，是治本，不止是 overflow:hidden 隐藏。 */
page, view, text, image, button, scroll-view, navigator, input, textarea { box-sizing: border-box; }
/* 双保险：根页面与 .page 容器都禁止横向溢出（overflow-x:hidden 在部分机型拦不住原生橡皮筋，故 border-box 为主、hidden 为辅） */
page { overflow-x: hidden; width: 100%; }
.page { padding: 24rpx; width: 100%; overflow-x: hidden; }
.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.row { display: flex; align-items: center; }
.row.between { justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.muted { color: var(--ink-3); }
.sm { font-size: 24rpx; }
.xs { font-size: 22rpx; }
.bold { font-weight: 600; }
.tap { transition: opacity .15s; }
.tap:active { opacity: .6; }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--ink); color: #fff;
  border-radius: 12rpx; padding: 18rpx 32rpx;
  font-size: 28rpx; border: 1rpx solid var(--ink);
  width: auto !important; /* 强制覆盖 mp <button> 原生默认 width:100%，使其按内容自适应（与设计稿一致） */
}
button.btn { width: auto !important; } /* 提高特异性再保险一层，确保压过原生 button 默认样式 */
.btn.ghost { background: #fff; color: var(--ink); }
.btn.block { width: 100% !important; } /* 整行按钮（创建/保存等）保持满宽，优先级高于上面的 auto */
.btn[disabled] { opacity: .4; }
.btn.sm { padding: 10rpx 20rpx; font-size: 24rpx; }
.btn.ghost.danger { color: var(--ink-3); border-style: dashed; }

/* 状态徽标（靠描边/字重/填充区分，不引入彩色） */
.badge {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; border: 1rpx solid var(--line); color: var(--ink-2);
}
.badge.ok { border-color: var(--ink); color: var(--ink); font-weight: 600; }
.badge.paused { border-style: dashed; color: var(--ink-3); }
.badge.full { background: var(--fill); color: var(--ink-3); border-color: var(--line); }
.badge.del { background: var(--ink); color: #fff; border-color: var(--ink); opacity: .55; }
.badge.expired { border-style: dashed; color: var(--ink-3); }
.badge.done { background: var(--ink); color: #fff; border-color: var(--ink); }
.badge.reject { border-color: var(--line); color: var(--ink-3); }

/* 品牌点缀（仅 logo / 小圆点 / 标签用） */
.brand-dot { display:inline-block; width:14rpx; height:14rpx; border-radius:50%; background:var(--brand); }
.brand-text { color: var(--brand); }

/* 步进器（人数 / 每日次数上限 / 提前开放天数 / 单次人数上限 统一规范）
   ⚠️ 微信 <button> 默认带 ::after 1rpx 边框 + 内边距，且 − / + 字形基线不同；
   必须用 flex 居中 + 去默认边框，否则符号偏上、两侧不对齐。 */
.stepper {
  display: inline-flex;
  align-items: stretch;                       /* 按钮与数值同高，分隔线对齐 */
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;                           /* 圆角裁切内部按钮 */
  background: #fff;
}
.stepper button {
  display: flex;
  align-items: center;
  justify-content: center;                    /* ± 在按钮内绝对居中 */
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  margin: 0;
  background: #fff;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;                             /* 配合 flex 居中，消除 line-height 撑偏 */
  border: none;
  border-radius: 0;
}
.stepper button::after { border: none; }      /* 去掉微信按钮默认 1rpx 边框 */
.stepper button:active { background: var(--fill); }
.stepper .v {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  padding: 0 10rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  border-left: 1rpx solid var(--line);       /* 细分隔线，控件更精致协调 */
  border-right: 1rpx solid var(--line);
}

/* 通用表单 */
.field { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.field .label { font-size: 24rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.field input, .field textarea { width: 100%; }

/* 统计块 KPI（数据分析看板） */
.kpi { background: var(--fill-2); border-radius: 12rpx; padding: 20rpx 24rpx; }
.kpi .label { font-size: 22rpx; color: var(--ink-3); }
.kpi .num { font-size: 40rpx; font-weight: 600; color: var(--ink); line-height: 1.2; margin-top: 6rpx; }
.kpi .sub { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }

/* 标签 chip：默认品牌描边；.danger 警示红实心（黑名单）；.fill 品牌实心（手动标签） */
.tag { display: inline-block; font-size: 20rpx; color: var(--brand); border: 1rpx solid var(--brand); border-radius: 8rpx; padding: 4rpx 12rpx; margin: 0 8rpx 8rpx 0; }
.tag.danger { color: #fff; background: var(--danger); border-color: var(--danger); }
.tag.fill { color: #fff; background: var(--brand); border-color: var(--brand); }
.tag.muted { color: var(--ink-3); border-color: var(--line); }

/* ===== 黑名单阻断态（全局复用：预约人卡片 / 待审核卡片 / 顾客档案） ===== */
/* 警示条：淡红底 + 左侧警示红竖条，保证在信息密集的列表里一眼可辨 */
.bl-bar {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--danger);
  background: rgba(163, 45, 45, .07);
  border-left: 4rpx solid var(--danger);
  border-radius: 6rpx;
  padding: 10rpx 16rpx;
}
/* 卡片级黑名单态：整卡淡红底 + 左侧红竖条（inset 阴影不占布局，不影响圆角裁切） */
.person.bl,
.card.bl-card {
  background: rgba(163, 45, 45, .05);
  box-shadow: inset 4rpx 0 0 var(--danger);
}
