/* app.wxss — 黑白极简设计令牌 + 一抹品牌色点缀（暖咖棕 #7A5230） */
page {
  --ink: #1A1A1A;          /* 主墨色 文字/描边 */
  --ink-2: #555555;        /* 次级文字 */
  --ink-3: #999999;        /* 弱化文字 */
  --line: #E7E7E7;         /* 分割线 */
  --fill: #F5F5F5;         /* 浅灰填充 */
  --fill-2: #FAFAFA;
  --brand: #7A5230;        /* 品牌色（仅点缀，不参与状态表达） */
  --ok: #1A1A1A;
  --warn: #8A6D3B;

  background: var(--fill-2);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 布局 */
.page { padding: 24rpx; }
.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.row { display: flex; align-items: center; }
.row.between { justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.muted { color: var(--ink-3); }
.sm { font-size: 24rpx; }
.xs { font-size: 22rpx; }
.bold { font-weight: 600; }
.tap { transition: opacity .15s; }
.tap:active { opacity: .6; }

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--ink); color: #fff;
  border-radius: 12rpx; padding: 18rpx 32rpx;
  font-size: 28rpx; border: 1rpx solid var(--ink);
}
.btn.ghost { background: #fff; color: var(--ink); }
.btn.block { width: 100%; }
.btn[disabled] { opacity: .4; }
.btn.sm { padding: 10rpx 20rpx; font-size: 24rpx; }
.btn.ghost.danger { color: var(--ink-3); border-style: dashed; }

/* 状态徽标（靠描边/字重/填充区分，不引入彩色） */
.badge {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 22rpx; border: 1rpx solid var(--line); color: var(--ink-2);
}
.badge.ok { border-color: var(--ink); color: var(--ink); font-weight: 600; }
.badge.paused { border-style: dashed; color: var(--ink-3); }
.badge.full { background: var(--fill); color: var(--ink-3); border-color: var(--line); }
.badge.del { background: var(--ink); color: #fff; border-color: var(--ink); opacity: .55; }
.badge.expired { border-style: dashed; color: var(--ink-3); }
.badge.done { background: var(--ink); color: #fff; border-color: var(--ink); }
.badge.reject { border-color: var(--line); color: var(--ink-3); }

/* 品牌点缀（仅 logo / 小圆点 / 标签用） */
.brand-dot { display:inline-block; width:14rpx; height:14rpx; border-radius:50%; background:var(--brand); }
.brand-text { color: var(--brand); }

/* 步进器 */
.stepper { display: inline-flex; align-items: center; border: 1rpx solid var(--line); border-radius: 10rpx; }
.stepper button { width: 56rpx; height: 56rpx; line-height: 56rpx; background: #fff; font-size: 32rpx; }
.stepper .v { min-width: 64rpx; text-align: center; }

/* 通用表单 */
.field { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.field .label { font-size: 24rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.field input, .field textarea { width: 100%; }
