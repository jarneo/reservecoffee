.fab {
  position: fixed;
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--ink);
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .20);
  font-size: 28rpx;
  overflow: hidden;
  animation: fabBreath 2.6s ease-in-out infinite;
}
/* 高光扫过：黑色浮球上周期性划过一道亮带，营造"闪闪、可点击"的观感 */
.fab::after {
  content: '';
  position: absolute;
  top: -40%;
  left: 0;
  width: 45%;
  height: 180%;
  background: linear-gradient(120deg,
    transparent 0%,
    rgba(255, 255, 255, .06) 35%,
    rgba(255, 255, 255, .62) 50%,
    rgba(255, 255, 255, .06) 65%,
    transparent 100%);
  transform: translateX(-180%) skewX(-18deg);
  animation: fabShine 3s ease-in-out infinite;
  pointer-events: none;
}
.fab-ico {
  display: inline-block;
  font-size: 34rpx;
  line-height: 1;
  animation: fabIco 1.8s ease-in-out infinite;
}
.fab-txt { font-weight: 600; letter-spacing: 1rpx; }
.fab:active { opacity: .85; animation: none; }
.fab:active::after { animation: none; }

/* 呼吸：阴影带品牌色 #7A5230 的柔光，随节律放大收小 */
@keyframes fabBreath {
  0%, 100% { box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .20); }
  50% { box-shadow: 0 10rpx 34rpx rgba(122, 82, 48, .38); }
}
/* 星标：放大旋转 + 金色微光闪烁，增强"闪闪"感 */
@keyframes fabIco {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; text-shadow: 0 0 0 rgba(122, 82, 48, 0); }
  50% { transform: scale(1.3) rotate(20deg); opacity: .82; text-shadow: 0 0 14rpx rgba(255, 210, 150, .9); }
}
/* 高光扫过：从左下扫到右上再隐去，循环 */
@keyframes fabShine {
  0% { transform: translateX(-180%) skewX(-18deg); }
  55%, 100% { transform: translateX(280%) skewX(-18deg); }
}
