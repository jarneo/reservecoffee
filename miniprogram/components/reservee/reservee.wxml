<view class="res-list">
  <view wx:if="{{list.length === 0}}" class="empty">该场次暂无预约人</view>

  <view wx:for="{{list}}" wx:key="_id" class="pcard" bindtap="onTap" data-id="{{item._id}}">
    <view class="row" style="align-items:flex-start">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="pinfo">
        <view class="row between" style="align-items:center">
          <view class="bold">{{item.name}} <text class="muted">· {{item.partySize}}人</text><text wx:if="{{item.isBlacklisted}}" class="bl-tag inline">黑名单</text></view>
          <view class="acts">
            <view class="badge {{item.review==='pending'?'paused':(item.status==='confirmed'?'ok':'full')}}">{{item.review==='pending'?'待审':(item.status==='confirmed'?'已确认':'已取消')}}</view>
            <view wx:if="{{canCancel}}" class="cancel-mini" catchtap="onCancel" data-id="{{item._id}}">取消预约</view>
          </view>
        </view>

        <!-- 号码 + 列表内直接拨号（原弹层能力，现在内联可见） -->
        <view class="row between" style="margin-top:10rpx;align-items:center">
          <view class="phone">{{item.phone || '无号码'}}</view>
          <view class="ph-btn {{item.phone?'':'disabled'}}" catchtap="onDial" data-id="{{item._id}}">📞 拨打</view>
        </view>

        <!-- 顾客补充信息（按项目 fields 配置采集）：管理员在列表就能看到，不必逐条点开 -->
        <view wx:if="{{item.wechat}}" class="sm muted" style="margin-top:8rpx">微信：{{item.wechat}}</view>
        <view wx:if="{{item.gender || item.age}}" class="sm muted" style="margin-top:4rpx">性别/年龄：{{item.gender || '—'}} · {{item.age || '—'}}</view>
        <view wx:if="{{item.note}}" class="sm" style="margin-top:4rpx;color:var(--brand)">备注：{{item.note}}</view>
        <view wx:if="{{item.isBlacklisted}}" class="bl-bar">⚠ 该顾客已被加入黑名单，无法再次预约<text wx:if="{{item.blacklistReason}}">（{{item.blacklistReason}}）</text></view>

        <view wx:if="{{item.openid}}" class="cust-link" catchtap="goAnalyze" data-id="{{item._id}}">查看顾客分析 ›</view>

        <!-- 待审预约：列表内直接审核（canReview 由父页面按「是否完整管理页」传入） -->
        <view wx:if="{{item.review==='pending' && canReview}}" class="review-row" catchtap="noop">
          <view class="rev-btn approve" catchtap="onReview" data-id="{{item._id}}" data-decision="approve">✓ 通过</view>
          <view class="rev-btn reject" catchtap="onReview" data-id="{{item._id}}" data-decision="reject">✕ 不通过</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{detail}}" class="sheet-mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="row between" style="align-items:flex-start">
        <view class="bold" style="font-size:34rpx">{{detail.name}}</view>
        <view class="x" bindtap="closeDetail">✕</view>
      </view>
      <view class="row" style="margin-top:12rpx;gap:24rpx">
        <view><view class="xs muted">电话</view><view>{{detail.phone}}</view></view>
        <view><view class="xs muted">人数</view><view>{{detail.partySize}} 人</view></view>
      </view>
      <view class="xs muted" style="margin-top:12rpx">审核：{{detail.review==='pending'?'待审核':(detail.review==='approved'?'已通过':'已拒绝')}}</view>
      <view wx:if="{{detail.note}}" style="margin-top:14rpx">
        <view class="xs muted">备注</view>
        <view style="font-size:28rpx;margin-top:4rpx;line-height:1.5;white-space:pre-wrap">{{detail.note}}</view>
      </view>
      <view wx:if="{{detail.wechat || detail.gender || detail.age}}" class="row" style="margin-top:12rpx;gap:28rpx;flex-wrap:wrap">
        <view wx:if="{{detail.wechat}}"><view class="xs muted">微信号</view><view>{{detail.wechat}}</view></view>
        <view wx:if="{{detail.gender}}"><view class="xs muted">性别</view><view>{{detail.gender}}</view></view>
        <view wx:if="{{detail.age}}"><view class="xs muted">年龄</view><view>{{detail.age}} 岁</view></view>
      </view>
      <button class="btn block call-lg" style="margin-top:20rpx" bindtap="dial">📞 拨打电话</button>
      <button class="btn block outline" style="margin-top:12rpx" bindtap="viewAnalyze">查看顾客分析</button>
      <view wx:if="{{detail.review==='pending' && canReview}}" class="row" style="margin-top:16rpx;gap:12rpx">
        <button class="btn block" bindtap="onReview" data-id="{{detail._id}}" data-decision="approve">✓ 通过</button>
        <button class="btn block outline" bindtap="onReview" data-id="{{detail._id}}" data-decision="reject">✕ 不通过</button>
      </view>
      <button class="btn block outline" style="margin-top:12rpx" bindtap="copyPhone" disabled="{{!detail.phone}}">复制号码</button>
      <button wx:if="{{detail.wechat}}" class="btn block outline" style="margin-top:12rpx" bindtap="copyWechat">复制微信号</button>
    </view>
  </view>
</view>
