.cal { background:#fff; border:1rpx solid var(--line); border-radius:16rpx; padding:20rpx; }
.cal-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; }
.cal-title { font-weight:600; }
.cal-week, .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:8rpx; }
.cal-week { margin-bottom:8rpx; }
.cw { text-align:center; font-size:22rpx; color:var(--ink-3); }
.cell { aspect-ratio:1; display:flex; align-items:center; justify-content:center; border:1rpx solid var(--line); border-radius:10rpx; font-size:24rpx; position:relative; }
.cell.empty { border:none; }
/* 可预约：墨黑描边高亮（对齐原型：开放日=ink 黑边，今天=橘圈） */
.cell.open { border:2rpx solid var(--ink); color:var(--ink); font-weight:600; background:#fff; }
/* 不可预约：灰色 */
.cell:not(.open):not(.empty) { background:var(--fill); color:var(--ink-3); }
/* 今天：橘色细圈（始终显示，与选中态区分） */
.cell.today::after { content:""; position:absolute; inset:3rpx; border:2rpx solid #E8833A; border-radius:7rpx; }
.cell .cd { line-height:1; }
.cal-legend { display:flex; align-items:center; font-size:20rpx; color:var(--ink-3); margin-top:14rpx; }
.cal-legend .dot { width:16rpx; height:16rpx; border-radius:50%; margin-right:6rpx; }
.cal-legend .dot.open { background:#fff; border:2rpx solid var(--ink); margin-left:18rpx; }
.cal-legend .dot.closed { background:var(--fill); border:2rpx solid var(--line); margin-left:18rpx; }
.cal-legend .dot.today { background:#fff; border:2rpx solid #E8833A; margin-left:18rpx; }
