<view class="scard">
  <view class="scard-row">
    <view class="bold scard-time">{{session.start}} – {{session.end}}</view>
    <view class="badge {{session.remaining<=0?'full':(session.paused?'paused':'ok')}}">{{session.paused?'已暂停':(session.remaining<=0?'已满':'剩'+session.remaining+'/'+session.capacity)}}</view>
  </view>
  <view wx:if="{{session.desc}}" class="xs muted" style="margin-top:6rpx">{{session.desc}}</view>
      <view class="actions" wx:if="{{showPause || canChangeCap || showCancel}}">
    <button wx:if="{{showPause && session.paused}}" class="btn ghost sm" size="mini" catchtap="onResume">恢复</button>
    <button wx:elif="{{showPause}}" class="btn ghost sm" size="mini" catchtap="onPause">暂停</button>
    <button wx:if="{{canChangeCap}}" class="btn ghost sm" size="mini" catchtap="onCap">改名额</button>
    <button wx:if="{{showCancel}}" class="btn ghost sm" size="mini" catchtap="onCancel">取消全部</button>
  </view>
</view>
