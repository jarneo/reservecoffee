/* components/pageLoading — 全屏加载遮罩
   设计：竖排书法「咖啡与清酒」的「墨迹落笔」——
        逐字落笔（入场，固定）→ 墨迹呼吸（静息，随加载自适应）→ 收笔淡出。
   底色：对齐**微信自己的启动页**——浅色纯白 / 深色纯黑，跟随系统外观。
   层级：默认 1050（压住 aiFab 的 999）；AI 页传 1090（必须 < 1100，见 ai.wxss 的 .pmask）。
   ⚠️ 深浅色：微信启动页跟随系统外观、小程序无法设置，只能让本遮罩也跟随系统，
      做到「白天白配白、晚上黑配黑」。墨色由素材决定：浅色用黑墨(l*)、深色用白墨(d*)。 */

.pl-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;      /* 浅色：纯白，对齐微信启动页 */
  opacity: 1;
}

/* 深色：纯黑，对齐微信夜间启动页 */
.pl-mask.pl-dark {
  background: #000000;
}

/* 淡出（收笔）：与页面底色有极浅色差，故比页面转场略长一点，过渡更柔和；
   淡出期间不拦截点击 */
.pl-mask.pl-fade {
  opacity: 0;
  transition: opacity 420ms ease-out;
  pointer-events: none;
}

/* ===== 书法墨迹 ===== */
/* 幅面宽 200rpx；高度由切片按 136:348 比例自然堆出（≈512rpx），随屏宽等比缩放 */
.pl-ink {
  width: 200rpx;
}

.pl-ink-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* 逐字落笔：每字自下方 16rpx、98% 缩放、0 透明度「落定」——先快后缓，像笔尖落纸 */
.pl-ink-s {
  display: block;
  width: 100%;
  opacity: 0;
  transform: translateY(16rpx) scale(0.98);
  transition: opacity 550ms ease, transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
}
.pl-ink-run .pl-ink-s {
  opacity: 1;
  transform: translateY(0) scale(1);
}
/* 逐字间隔 ~130ms，自上而下依次点亮 */
.pl-ink-run .pl-ink-s:nth-child(1) { transition-delay: 0ms; }
.pl-ink-run .pl-ink-s:nth-child(2) { transition-delay: 130ms; }
.pl-ink-run .pl-ink-s:nth-child(3) { transition-delay: 260ms; }
.pl-ink-run .pl-ink-s:nth-child(4) { transition-delay: 390ms; }
.pl-ink-run .pl-ink-s:nth-child(5) { transition-delay: 520ms; }

/* 小横笔（收势）：末字落定后一记「按笔」出现 */
.pl-ink-mark-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  opacity: 0;
  transform: scale(0.4);
  transform-origin: 20% 66%;
  transition: opacity 280ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
}
.pl-ink-run .pl-ink-mark-img {
  opacity: 1;
  transform: scale(1);
  transition-delay: 700ms;
}

/* 静息：整幅墨迹极轻呼吸（幅度刻意压到几乎察觉不到） */
.pl-ink-breath .pl-ink-inner {
  animation: plInkBreath 2.8s ease-in-out infinite;
}
@keyframes plInkBreath {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.9; transform: scale(1.012); }
}

/* 兜底：素材加载失败时的竖排文字（绝不白屏） */
.pl-ink-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 44rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: #1A1A1A;
}
.pl-dark .pl-ink-ph {
  color: #FFFFFF;
}

/* 落款小字：默认不渲染；页面显式传 title 才出现 */
.pl-sub {
  margin-top: 40rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #999999;
}
.pl-dark .pl-sub {
  color: rgba(255, 255, 255, 0.55);
}
