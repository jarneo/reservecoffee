/* components/pageLoading — 全屏加载遮罩
   视觉：竖排书法「咖啡与清酒」**静态常显** + 「二曜路8号」逐字落笔落款（可循环）。
   底色：对齐**微信自己的启动页**——浅色纯白 / 深色纯黑，跟随系统外观。
   层级：默认 1050（压住 aiFab 的 999）；AI 页传 1090（必须 < 1100，见 ai.wxss 的 .pmask）。
   ⚠️ 深浅色：微信启动页跟随系统外观、小程序无法设置，只能让本遮罩也跟随系统，
      做到「白天白配白、晚上黑配黑」。墨色由素材决定：浅色用黑墨(hero-l)、深色用白墨(hero-d)。 */

.pl-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;      /* 浅色：纯白，对齐微信启动页 */
  opacity: 1;
}

/* 深色：纯黑，对齐微信夜间启动页 */
.pl-mask.pl-dark {
  background: #000000;
}

/* 淡出（收笔）：与页面底色有极浅色差，故比页面转场略长一点，过渡更柔和；
   淡出期间不拦截点击 */
.pl-mask.pl-fade {
  opacity: 0;
  transition: opacity 420ms ease-out;
  pointer-events: none;
}

/* ===== 书法主体（静态常显，无动画）===== */
/* 幅面宽 200rpx；高度由素材按 272:696 比例自然堆出（≈512rpx），随屏宽等比缩放 */
.pl-ink {
  width: 200rpx;
}

.pl-ink-hero {
  display: block;
  width: 100%;
}

/* 兜底：素材加载失败时的竖排文字（绝不白屏） */
.pl-ink-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 44rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  color: #1A1A1A;
}
.pl-dark .pl-ink-ph {
  color: #FFFFFF;
}

/* ===== 落款「二曜路8号」：逐字落笔 · 循环 ===== */
/* 固定行高：落笔的位移/缩放不会撑动布局，避免整屏元素跟着抖 */
.pl-sub {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  margin-top: 44rpx;
  height: 40rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #8A8A8A;
}
.pl-dark .pl-sub {
  color: rgba(255, 255, 255, 0.62);
}

/* 单字时序（周期 2200ms，错峰 90ms 由 wxml 内联 style 给）：
   0% 隐藏 → 17%(≈374ms) 落定 → 86%(≈1892ms) 保持可见 → 100% 淡出重来。
   末字落定 ≈ 360+374 = 734ms，之后到 1892ms 仍有 ≈1.16s 的完整可读时间；
   若此时加载仍未完成，动画自动进入下一轮，无需任何 JS。 */
.pl-sub-c {
  display: inline-block;
  margin: 0 3rpx;
  opacity: 0;
  animation: plSubIn 2200ms cubic-bezier(0.22, 1, 0.36, 1) infinite both;
}

@keyframes plSubIn {
  0%   { opacity: 0; transform: translateY(10rpx) scale(0.9); }
  17%  { opacity: 1; transform: translateY(0) scale(1); }
  86%  { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(0) scale(1); }
}
