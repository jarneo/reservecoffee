/* components/pageLoading — 全屏加载遮罩
   视觉：主书法「咖啡与清酒」竖排**静态常显、无动画**；
        + 落款「二曜路8号」竖排小字逐字落笔（播完未就绪则循环重播）。
   底色：对齐**微信自己的启动页**——浅色纯白 / 深色纯黑，跟随系统外观。
   层级：默认 1050（压住 aiFab 的 999）；AI 页传 1090（必须 < 1100，见 ai.wxss 的 .pmask）。
   ⚠️ 深浅色：微信启动页跟随系统外观、小程序无法设置，只能让本遮罩也跟随系统，
      做到「白天白配白、晚上黑配黑」。墨色由素材决定：浅色黑墨(hero-l/sig-l*)、深色白墨(hero-d/sig-d*)。

   几何（全部来自源图墨迹实测，改素材请同步改这里）：
     源图整幅墨迹 = x259-368 / y407-730 = 110 × 324
       主书法    x316-368 / y407-727   → 容器内 left 57/110, width 53/110
       落款列    x259-280 / y620-730   → 容器内 left 0,    贴容器底（bottom:0）
     容器宽 210rpx → 高 = 324/110 × 210 ≈ 618rpx */

.pl-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;      /* 浅色：纯白，对齐微信启动页 */
  opacity: 1;
}

/* 深色：纯黑，对齐微信夜间启动页 */
.pl-mask.pl-dark {
  background: #000000;
}

/* 淡出（收笔）：与页面底色有极浅色差，故比页面转场略长一点，过渡更柔和；
   淡出期间不拦截点击 */
.pl-mask.pl-fade {
  opacity: 0;
  transition: opacity 420ms ease-out;
  pointer-events: none;
}

/* ===== 字幅容器（相对定位基座；尺寸 = 源图整幅墨迹比例）===== */
.pl-mark {
  position: relative;
  width: 210rpx;
  height: 618rpx;
}

/* ===== 主书法「咖啡与清酒」：静态常显，无动画 ===== */
.pl-mark-hero {
  position: absolute;
  left: 51.82%;    /* 57/110 */
  top: 0;
  width: 48.18%;   /* 53/110，高度由 mode=widthFix 按 53:321 自然得出 ≈613rpx */
}

/* 兜底：素材加载失败时的竖排文字（绝不白屏） */
.pl-mark-ph {
  position: absolute;
  left: 51.82%;
  top: 0;
  width: 48.18%;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 44rpx;
  line-height: 1.5;
  color: #1A1A1A;
}
.pl-dark .pl-mark-ph {
  color: #FFFFFF;
}

/* ===== 落款「二曜路8号」：竖排小字，贴容器左下 ===== */
/* 5 段连续无缝切片纵向堆叠 → 自然还原原图字距；bottom:0 让它与书法底部对齐 */
.pl-sign {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 20%;      /* 22/110 */
  display: flex;
  flex-direction: column;
}

/* 单字时序（周期 2200ms，错峰 90ms 由 wxml 内联 style 给）：
   0% 隐藏 → 17%(≈374ms) 落定 → 86%(≈1892ms) 保持可见 → 100% 淡出重来。
   末字落定 ≈ 360+374 = 734ms，之后到 1892ms 仍有 ≈1.16s 完整可读时间；
   若此时加载仍未完成，动画自动进入下一轮，无需任何 JS。 */
.pl-sign-c {
  display: block;
  width: 100%;
  opacity: 0;
  animation: plSignIn 2200ms cubic-bezier(0.22, 1, 0.36, 1) infinite both;
}

@keyframes plSignIn {
  0%   { opacity: 0; transform: translateY(6rpx) scale(0.86); }
  17%  { opacity: 1; transform: translateY(0) scale(1); }
  86%  { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(0) scale(1); }
}

/* 兜底：落款素材失败时用竖排文字顶上（同一套动画） */
.pl-sign-ph .pl-sign-c {
  font-size: 18rpx;
  line-height: 1.5;
  text-align: center;
  color: #8A8A8A;
}
.pl-dark .pl-sign-ph .pl-sign-c {
  color: rgba(255, 255, 255, 0.62);
}
